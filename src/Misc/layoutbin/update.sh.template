#!/bin/bash

# agent will replace key words in the template and generate a batch script to run.
# Keywords:
#  PROCESSID = pid
#  AGENTPROCESSNAME = agent.listener[.exe]
#  ROOTFOLDER = ./
#  EXISTAGENTVERSION = 2.100.0
#  DOWNLOADAGENTVERSION = 2.101.0
#  UPDATELOG = _diag/SelfUpdate-UTC.log
#  RESTARTINTERACTIVEAGENT = 0/1

agentpid=_PROCESS_ID_
agentprocessname=_AGENT_PROCESS_NAME_
rootfolder="_ROOT_FOLDER_"
existagentversion=_EXIST_AGENT_VERSION_
downloadagentversion=_DOWNLOAD_AGENT_VERSION_
logfile="_UPDATE_LOG_"
restartinteractiveagent=_RESTART_INTERACTIVE_AGENT_

service_script="$rootfolder/runsvc.sh"
new_service_script="$rootfolder/bin.$downloadagentversion/runsvc.sh"
service_script_backup=""
service_manifest="$rootfolder/bin.$downloadagentversion/runsvc.sh.sha256"
service_hook="$rootfolder/runsvc.hook.sh"
service_hook_created=0
service_hook_digest=""
service_marker="# insert anything to setup env when running as a service"
migration_reason=""
service_script_replaced=0
update_succeeded=0

service_script_error() {
    printf 'ERROR: %s\n' "$1" >> "$logfile"
    printf 'ERROR: %s\n' "$1" >&2
}

report_service_script_status() {
    # Older listeners cannot report this check. Use the downloaded listener without delaying the update.
    if [ -x "$rootfolder/bin.$downloadagentversion/Agent.Listener" ]; then
        "$rootfolder/bin.$downloadagentversion/Agent.Listener" --service-script-telemetry "$1" \
            </dev/null >/dev/null 2>&1 &
    else
        printf 'WARNING: Unable to start service-script telemetry reporter.\n' >> "$logfile"
    fi
}

write_service_script_preview() {
    local preview="$service_script.new" temporary
    if [ -e "$preview" ] || [ -L "$preview" ]; then
        printf 'Existing %s was not overwritten.\n' "$preview" >> "$logfile"
        return
    fi
    temporary=$(mktemp "$rootfolder/.runsvc-preview.XXXXXX") || {
        printf 'WARNING: Could not create a service-script preview.\n' >> "$logfile"
        return
    }
    if cp -p "$new_service_script" "$temporary" >> "$logfile" 2>&1 &&
       ln "$temporary" "$preview" >> "$logfile" 2>&1; then
        printf 'New service script available for review at %s.\n' "$preview" >> "$logfile"
    else
        printf 'WARNING: Could not create %s; existing files were not overwritten.\n' "$preview" >> "$logfile"
    fi
    rm -f "$temporary"
}

sha256_of_stdin() {
    local digest
    if command -v sha256sum >/dev/null 2>&1; then
        digest=$(sha256sum 2>> "$logfile") || return 1
    elif command -v shasum >/dev/null 2>&1; then
        digest=$(shasum -a 256 2>> "$logfile") || return 1
    else
        return 1
    fi
    digest="${digest%% *}"
    [[ "$digest" =~ ^[0-9a-f]{64}$ ]] || return 1
    printf '%s\n' "$digest"
}

service_script_fingerprint() {
    sha256_of_stdin < "$1"
}

# Stock scripts are stamped at build time with a final line containing the SHA-256 of all preceding bytes.
# Returns 0 for a valid stamp, 1 when there is no matching stamp, and 2 when the file cannot be checked.
service_script_stamp_matches() {
    local file="$1" prefix='# agent-stock-sha256: ' size marker_length marker expected actual
    marker_length=$(( ${#prefix} + 65 ))
    size=$(wc -c < "$file" 2>> "$logfile") || return 2
    size="${size//[[:space:]]/}"
    [[ "$size" =~ ^[0-9]+$ ]] || return 2
    [ "$size" -gt "$marker_length" ] || return 1
    marker=$(LC_ALL=C tail -c "$marker_length" "$file" 2>/dev/null) || return 2
    [[ "$marker" =~ ^"$prefix"([0-9a-f]{64})$ ]] || return 1
    expected="${BASH_REMATCH[1]}"
    # Require exact bytes: a newline before the marker and exactly one trailing newline.
    LC_ALL=C cmp -s <(tail -c "$(( marker_length + 1 ))" "$file") <(printf '\n%s%s\n' "$prefix" "$expected") || return 1
    actual=$(head -c "$(( size - marker_length ))" "$file" | sha256_of_stdin) || return 2
    [ "$actual" = "$expected" ] || return 1
}

# Returns 0 when the fingerprint is a known stock script, 1 when it is not, and 2 on error.
# The frozen list is needed only for scripts without a valid stamp.
is_stock_fingerprint() {
    local result
    if [ ! -f "$service_manifest" ] || [ ! -r "$service_manifest" ]; then
        echo "Cannot read the frozen service-script fingerprint list $service_manifest." >> "$logfile"
        return 2
    fi
    awk -v expected="$1" '
        { sub(/\r$/, ""); if ($0 == expected) { found = 1; exit } }
        END { if (!found) exit 1 }
    ' "$service_manifest" 2>> "$logfile"
    result=$?
    [ "$result" -le 1 ] && return "$result"
    return 2
}

# Customizations can be migrated only when they were added directly after the documented insertion
# marker and removing them yields a known stock script. Only literal exports are accepted;
# shell commands, expansions, and assignments to shell-special variables cannot be moved safely.
# Returns 0 and writes the customization to $1, 1 when it cannot be migrated safely, and 2 on error.
extract_service_customization() {
    local output="$1" snapshot="$2" marker_line count lines k digest result matches=0 match=0
    count=$(grep -c -x -F -e "$service_marker" "$snapshot" 2>> "$logfile")
    if [ "$count" != "1" ]; then
        migration_reason="the documented insertion marker was not found exactly once"
        return 1
    fi
    marker_line=$(grep -n -x -F -e "$service_marker" "$snapshot" 2>> "$logfile") || return 2
    marker_line="${marker_line%%:*}"
    lines=$(wc -l < "$snapshot") || return 2
    lines="${lines//[[:space:]]/}"
    [[ "$marker_line" =~ ^[0-9]+$ && "$lines" =~ ^[0-9]+$ ]] || return 2

    # Stamped candidates do not need the frozen list; unstamped candidates fail closed without it.
    local manifest_available=1 manifest_needed=0
    if [ ! -f "$service_manifest" ] || [ ! -r "$service_manifest" ]; then
        manifest_available=0
    fi
    for ((k = marker_line + 1; k <= lines + 2; k++)); do
        { head -n "$marker_line" "$snapshot" && tail -n "+$k" "$snapshot"; } > "$output" || return 2
        service_script_stamp_matches "$output"
        result=$?
        if [ "$result" -eq 1 ]; then
            if [ "$manifest_available" -eq 0 ]; then
                manifest_needed=1
                continue
            fi
            digest=$(service_script_fingerprint "$output") || return 2
            is_stock_fingerprint "$digest"
            result=$?
        fi
        if [ "$result" -eq 0 ]; then
            matches=$((matches + 1))
            match=$k
        elif [ "$result" -ne 1 ]; then
            return 2
        fi
    done
    if [ "$matches" -eq 0 ] && [ "$manifest_needed" -eq 1 ]; then
        echo "Cannot read the frozen service-script fingerprint list $service_manifest." >> "$logfile"
        return 2
    fi
    if [ "$matches" -ne 1 ]; then
        migration_reason="changes were found outside the documented insertion region"
        return 1
    fi

    tail -n "+$((marker_line + 1))" "$snapshot" | head -n "$((match - marker_line - 1))" > "$output" || return 2
    if ! cmp -s "$snapshot" <(head -n "$marker_line" "$snapshot"; cat "$output"; tail -n "+$match" "$snapshot"); then
        migration_reason="the customization could not be separated exactly"
        return 1
    fi

    if [ "$(tr -d '\000' < "$output" | wc -c)" != "$(wc -c < "$output")" ]; then
        migration_reason="the customization contains binary data"
        return 1
    fi
    # This is an allowlist, not a shell parser. Single quotes preserve every printable literal;
    # double quotes must not contain expansions or escapes, and unquoted values use a small alphabet.
    LC_ALL=C awk '
        /^[ \t]*(#.*)?$/ { next }
        {
            line = $0
            sub(/^[ \t]*/, "", line)
            sub(/[ \t]*$/, "", line)
            if (line !~ /^export[ \t]+[A-Za-z_][A-Za-z0-9_]*=/) exit 1
            sub(/^export[ \t]+/, "", line)
            name = line
            sub(/=.*/, "", name)
            if (name ~ /^(_|BASH.*|HIST.*|COMP.*|EPOCH.*|PS[0-9]|SHELLOPTS|CDPATH|COLUMNS|DIRSTACK|ENV|EUID|EXECIGNORE|FCEDIT|FIGNORE|FUNCNAME|GLOBIGNORE|GROUPS|HOME|HOSTFILE|HOSTNAME|HOSTTYPE|IFS|IGNOREEOF|INPUTRC|LANG|LC_.*|LINENO|LINES|MACHTYPE|MAIL|MAILCHECK|MAILPATH|OLDPWD|OPTARG|OPTERR|OPTIND|OSTYPE|PIPESTATUS|POSIXLY_CORRECT|PPID|PROMPT_COMMAND|PWD|RANDOM|REPLY|SECONDS|SHLVL|SRANDOM|TIMEFORMAT|TMOUT|TMPDIR|UID|auto_resume|histchars)$/) exit 1
            sub(/^[^=]*=/, "", line)
            if (line ~ /^[-A-Za-z0-9_./:@%+,]*$/ ||
                line ~ /^\047[^\047[:cntrl:]]*\047$/ ||
                line ~ /^"[^"$`\\[:cntrl:]]*"$/) next
            exit 1
        }
    ' "$output" 2>> "$logfile"
    result=$?
    if [ "$result" -eq 1 ]; then
        migration_reason="only one literal export of a non-shell-special variable per line, blank lines, and comments can be migrated; shell commands, expansions, escapes, and other syntax require manual migration"
        return 1
    elif [ "$result" -ne 0 ]; then
        return 2
    fi
}

block_customized_service_script() {
    report_service_script_status Unrecognized
    write_service_script_preview
    service_script_error "$service_script is customized or unrecognized, and its customizations cannot be migrated automatically: $migration_reason. Agent update blocked; preserve your changes, move them to $service_hook, and restore the stock script from $service_script.new."
}

remove_created_service_hook() {
    if [ "$service_hook_created" -eq 1 ]; then
        local digest
        if [ ! -L "$service_hook" ] && digest=$(service_script_fingerprint "$service_hook") &&
           [ "$digest" = "$service_hook_digest" ] && rm -f "$service_hook"; then
            service_hook_created=0
            return 0
        fi
        printf 'ERROR: Could not remove %s created by this update.\n' "$service_hook" >> "$1"
        printf 'ERROR: Could not remove %s created by this update.\n' "$service_hook" >&2
        return 1
    fi
}

write_service_hook() {
    local customization="$1" temporary
    temporary=$(mktemp "$rootfolder/.runsvc-hook.XXXXXX") || return 1
    # Copy the backup first so the hook keeps the original script's owner and restrictive mode.
    if ! cp -a "$service_script_backup" "$temporary" >> "$logfile" 2>&1 ||
       [ -L "$temporary" ] ||
       ! {
           printf '# Service customizations migrated from runsvc.sh while updating the agent from %s to %s.\n' \
               "$existagentversion" "$downloadagentversion"
           printf '# runsvc.sh sources this file before starting the agent. Agent updates preserve it.\n'
           cat "$customization"
       } > "$temporary" ||
       ! service_hook_digest=$(service_script_fingerprint "$temporary") ||
       ! ln "$temporary" "$service_hook" >> "$logfile" 2>&1; then
        rm -f "$temporary"
        return 1
    fi
    rm -f "$temporary"
    service_hook_created=1
}

refresh_service_script() {
    local digest backup_digest result temporary snapshot customization="" migrate=0

    if [ -L "$service_script" ]; then
        migration_reason="it is a symbolic link"
        block_customized_service_script
        return 1
    fi
    if [ ! -e "$service_script" ]; then
        if [ -e "$rootfolder/.service" ] || [ -L "$rootfolder/.service" ]; then
            report_service_script_status Missing
            service_script_error "$service_script is missing for a configured service. Agent update blocked."
            return 1
        fi
        report_service_script_status NoService
        return 0
    fi
    if [ ! -f "$service_script" ] || [ ! -r "$service_script" ] ||
       [ ! -r "$new_service_script" ] ||
       ! bash -n "$new_service_script" >> "$logfile" 2>&1; then
        report_service_script_status Error
        service_script_error "Cannot verify $service_script or the downloaded service script. Agent update blocked."
        return 1
    fi

    # Classify a private snapshot so the stamp and digest describe the same bytes.
    snapshot=$(mktemp "$rootfolder/.runsvc-check.XXXXXX") || snapshot=""
    if [ -z "$snapshot" ] || ! cat "$service_script" > "$snapshot" 2>> "$logfile" ||
       ! digest=$(service_script_fingerprint "$snapshot"); then
        [ -n "$snapshot" ] && rm -f "$snapshot"
        report_service_script_status Error
        service_script_error "Cannot calculate the SHA-256 fingerprint of $service_script. Agent update blocked."
        return 1
    fi

    service_script_stamp_matches "$snapshot"
    result=$?
    if [ "$result" -eq 1 ] && [ ! -r "$service_manifest" ] &&
       tail -n 1 "$snapshot" 2>> "$logfile" | grep -q -E '^# agent-stock-sha256: [0-9a-f]{64}$'; then
        # A customized stamped script can be verified from its own stamp during migration.
        result=1
    elif [ "$result" -eq 1 ]; then
        # Scripts shipped before build-time stamping are recognized by the frozen fingerprint list.
        is_stock_fingerprint "$digest"
        result=$?
    elif [ "$result" -ne 0 ]; then
        result=2
    fi
    if [ "$result" -eq 1 ]; then
        if [ -e "$service_hook" ] || [ -L "$service_hook" ]; then
            rm -f "$snapshot"
            migration_reason="$service_hook already exists"
            block_customized_service_script
            return 1
        fi
        customization=$(mktemp "$rootfolder/.runsvc-customization.XXXXXX") || {
            rm -f "$snapshot"
            report_service_script_status Error
            service_script_error "Cannot create a temporary file to inspect $service_script. Agent update blocked."
            return 1
        }
        extract_service_customization "$customization" "$snapshot"
        result=$?
        rm -f "$snapshot"
        if [ "$result" -ne 0 ]; then
            rm -f "$customization"
            if [ "$result" -eq 1 ]; then
                block_customized_service_script
            else
                report_service_script_status Error
                service_script_error "Cannot inspect the customizations in $service_script. Agent update blocked."
            fi
            return 1
        fi
        migrate=1
    elif [ "$result" -ne 0 ]; then
        rm -f "$snapshot"
        report_service_script_status Error
        service_script_error "Cannot verify the service-script fingerprint. Agent update blocked."
        return 1
    else
        rm -f "$snapshot"
        report_service_script_status Stock
        cmp -s "$service_script" "$new_service_script"
        result=$?
        if [ "$result" -eq 0 ]; then
            printf '%s is already up to date.\n' "$service_script" >> "$logfile"
            return 0
        elif [ "$result" -ne 1 ]; then
            service_script_error "Cannot compare $service_script with the downloaded script. Agent update blocked."
            return 1
        fi
    fi

    temporary=$(mktemp "$rootfolder/.runsvc-update.XXXXXX") || {
        rm -f "$customization"
        service_script_error "Cannot create a temporary service script. Agent update blocked."
        return 1
    }
    service_script_backup=$(mktemp "$service_script.$existagentversion.bak.XXXXXX") || {
        rm -f "$temporary" "$customization"
        service_script_error "Cannot create a backup of $service_script. Agent update blocked."
        return 1
    }
    # Copy the old file first to preserve its mode, owner and platform-specific attributes.
    if ! cp -a "$service_script" "$service_script_backup" >> "$logfile" 2>&1 ||
       [ -L "$service_script_backup" ] ||
       ! backup_digest=$(service_script_fingerprint "$service_script_backup") ||
       [ "$backup_digest" != "$digest" ] ||
       ! cp -a "$service_script_backup" "$temporary" >> "$logfile" 2>&1 ||
       [ -L "$temporary" ] ||
       ! cat "$new_service_script" > "$temporary" ||
       ! bash -n "$temporary" >> "$logfile" 2>&1; then
        rm -f "$temporary" "$customization"
        service_script_error "Cannot safely replace $service_script. Agent update blocked; backup: $service_script_backup."
        return 1
    fi
    if [ "$migrate" -eq 1 ]; then
        if ! write_service_hook "$customization"; then
            rm -f "$temporary" "$customization"
            service_script_error "Cannot create $service_hook without overwriting an existing file. Agent update blocked; backup: $service_script_backup."
            return 1
        fi
        rm -f "$customization"
    fi
    if [ -L "$service_script" ] ||
       ! cmp -s "$service_script_backup" "$service_script" ||
       ! mv -f "$temporary" "$service_script" >> "$logfile" 2>&1; then
        rm -f "$temporary"
        remove_created_service_hook "$logfile"
        service_script_error "Cannot safely replace $service_script. Agent update blocked; backup: $service_script_backup."
        return 1
    fi

    service_script_replaced=1
    if [ "$migrate" -eq 1 ]; then
        printf 'Moved customizations from %s to %s and replaced the script; previous script saved at %s. Restart the service to use it.\n' \
            "$service_script" "$service_hook" "$service_script_backup" >> "$logfile"
    else
        printf 'Replaced %s; previous script saved at %s. Restart the service to use it.\n' \
            "$service_script" "$service_script_backup" >> "$logfile"
    fi
}
restore_service_script_on_failure() {
    if [ "$service_script_replaced" -eq 1 ] && [ "$update_succeeded" -eq 0 ]; then
        local temporary log="$logfile"
        if [ ! -e "$log" ] && [ -f "$logfile.failed" ]; then
            log="$logfile.failed"
        fi
        if [ -L "$service_script" ] || ! cmp -s "$service_script" "$new_service_script"; then
            printf 'ERROR: Cannot restore %s because it changed; backup: %s.\n' "$service_script" "$service_script_backup" >> "$log"
            printf 'ERROR: Cannot restore %s because it changed; backup: %s.\n' "$service_script" "$service_script_backup" >&2
            return
        fi
        temporary=$(mktemp "$rootfolder/.runsvc-restore.XXXXXX")
        if [ -n "$temporary" ] &&
           cp -a "$service_script_backup" "$temporary" >> "$log" 2>&1 &&
           mv -f "$temporary" "$service_script" >> "$log" 2>&1; then
            printf 'Restored %s after the update failed.\n' "$service_script" >> "$log"
            remove_created_service_hook "$log"
        else
            printf 'ERROR: Could not restore %s; backup: %s.\n' "$service_script" "$service_script_backup" >> "$log"
            printf 'ERROR: Could not restore %s; backup: %s.\n' "$service_script" "$service_script_backup" >&2
            [ -n "$temporary" ] && rm -f "$temporary"
        fi
    fi
}
trap restore_service_script_on_failure EXIT

# log user who run the script
date "+[%F %T-%4N] --------whoami--------" >> "$logfile" 2>&1
whoami >> "$logfile" 2>&1
date "+[%F %T-%4N] --------whoami--------" >> "$logfile" 2>&1

# wait for agent process to exit.
date "+[%F %T-%4N] Waiting for $agentprocessname ($agentpid) to complete" >> "$logfile" 2>&1
while [ -e /proc/$agentpid ]
do
    date "+[%F %T-%4N] Process $agentpid still running" >> "$logfile" 2>&1
    # explicitly setting interval to 1 sec since it is possible for a host to have a different
    # default interval value
    ping -c 2 -i 1 127.0.0.1 > /dev/null
done
date "+[%F %T-%4N] Process $agentpid finished running" >> "$logfile" 2>&1

# start re-organize folders
date "+[%F %T-%4N] Sleep 1 more second to make sure process exited" >> "$logfile" 2>&1
ping -c 2 -i 1 127.0.0.1 > /dev/null

# The new runsvc.sh hosts AgentService.js on the bundled Node 24. Refuse to switch to an agent
# whose Node 24 cannot run here (for example, an OS whose glibc is too old) and keep the current agent.
node24="$rootfolder/externals.$downloadagentversion/node24/bin/node"
date "+[%F %T-%4N] Checking that $node24 can run on this machine" >> "$logfile" 2>&1
if ! "$node24" --version >> "$logfile" 2>&1; then
    service_script_error "Node.js 24 ($node24) cannot run on this machine. Agent update blocked; the current agent remains active. Upgrade the operating system to one supported by Node.js 24."
    report_service_script_status Node24Unsupported
    mv -fv "$logfile" "$logfile.failed"
    if [ "$restartinteractiveagent" -ne 0 ]; then
        "$rootfolder/run.sh" &
    fi
    exit 1
fi

if ! refresh_service_script; then
    mv -fv "$logfile" "$logfile.failed"
    if [ "$restartinteractiveagent" -ne 0 ]; then
        "$rootfolder/run.sh" &
    fi
    exit 1
fi

# the folder structure under agent root will be
# ./bin -> bin.2.100.0 (junction folder)
# ./externals -> externals.2.100.0 (junction folder)
# ./bin.2.100.0
# ./externals.2.100.0
# ./bin.2.99.0
# ./externals.2.99.0
# by using the junction folder we can avoid file in use problem.

# if the bin/externals junction point already exist, we just need to delete the junction point then re-create to point to new bin/externals folder.
# if the bin/externals still are real folders, we need to rename the existing folder to bin.version format then create junction point to new bin/externals folder.

# check bin folder
if [[ -L "$rootfolder/bin" && -d "$rootfolder/bin" ]]
then
    # return code 0 means it find a bin folder that is a junction folder
    # we just need to delete the junction point.
    date "+[%F %T-%4N] Delete existing junction bin folder" >> "$logfile" 2>&1
    rm -f "$rootfolder/bin" >> "$logfile" 2>&1
    if [ $? -ne 0 ]
    then
        date "+[%F %T-%4N] Cannot delete existing junction bin folder" >> "$logfile" 2>&1
        mv -fv "$logfile" "$logfile.failed"
        exit 1
    fi
else
   # otherwise, we need to move the current bin folder to bin.2.99.0 folder.
    date "+[%F %T-%4N] move $rootfolder/bin $rootfolder/bin.$existagentversion" >> "$logfile" 2>&1
    mv -fv "$rootfolder/bin" "$rootfolder/bin.$existagentversion" >> "$logfile" 2>&1
    if [ $? -ne 0 ]
    then
        date "+[%F %T-%4N] Cannot move $rootfolder/bin to $rootfolder/bin.$existagentversion" >> "$logfile" 2>&1
        mv -fv "$logfile" "$logfile.failed"
        exit 1
    fi
fi

# check externals folder
if [[ -L "$rootfolder/externals" && -d "$rootfolder/externals" ]]
then
    # the externals folder is already a junction folder
    # we just need to delete the junction point.
    date "+[%F %T-%4N] Delete existing junction externals folder" >> "$logfile" 2>&1
    rm -f "$rootfolder/externals" >> "$logfile" 2>&1
    if [ $? -ne 0 ]
    then
        date "+[%F %T-%4N] Cannot delete existing junction externals folder" >> "$logfile" 2>&1
        mv -fv "$logfile" "$logfile.failed"
        exit 1
    fi
else
    # otherwise, we need to move the current externals folder to externals.2.99.0 folder.
    date "+[%F %T-%4N] move $rootfolder/externals $rootfolder/externals.$existagentversion" >> "$logfile" 2>&1
    mv -fv "$rootfolder/externals" "$rootfolder/externals.$existagentversion" >> "$logfile" 2>&1
    if [ $? -ne 0 ]
    then
        date "+[%F %T-%4N] Cannot move $rootfolder/externals to $rootfolder/externals.$existagentversion" >> "$logfile" 2>&1
        mv -fv "$logfile" "$logfile.failed"
        exit 1
    fi
fi

# create junction bin folder
date "+[%F %T-%4N] Create junction bin folder" >> "$logfile" 2>&1
ln -s "$rootfolder/bin.$downloadagentversion" "$rootfolder/bin" >> "$logfile" 2>&1
if [ $? -ne 0 ]
then
    date "+[%F %T-%4N] Cannot create junction bin folder" >> "$logfile" 2>&1
    mv -fv "$logfile" "$logfile.failed"
    exit 1
fi

# create junction externals folder
date "+[%F %T-%4N] Create junction externals folder" >> "$logfile" 2>&1
ln -s "$rootfolder/externals.$downloadagentversion" "$rootfolder/externals" >> "$logfile" 2>&1
if [ $? -ne 0 ]
then
    date "+[%F %T-%4N] Cannot create junction externals folder" >> "$logfile" 2>&1
    mv -fv "$logfile" "$logfile.failed"
    exit 1
fi

update_succeeded=1
if [ "$service_hook_created" -eq 1 ]; then
    report_service_script_status Migrated
fi
date "+[%F %T-%4N] Update succeed" >> "$logfile" 2>&1

# rename the update log file with %logfile%.succeed/.failed/succeedneedrestart
# agent service host can base on the log file name determin the result of the agent update
date "+[%F %T-%4N] Rename $logfile to be $logfile.succeed" >> "$logfile" 2>&1
mv -fv "$logfile" "$logfile.succeed"

# restart interactive agent if needed
if [ $restartinteractiveagent -ne 0 ]
then
    date "+[%F %T-%4N] Restarting interactive agent"  >> "$logfile.succeed" 2>&1
    "$rootfolder/run.sh" &
fi
